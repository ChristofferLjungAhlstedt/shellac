[Icon Theme]
Name=Hicolor
Comment=Fallback icon theme carrying paneterm's bundled symbolic icons
Directories=scalable/actions,scalable/apps,scalable/mimetypes

[scalable/actions]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Actions

[scalable/apps]
Size=128
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/mimetypes]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes
